<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Predefined vector images for each entity type (theme T7 - reactor       -->
    <!-- temperature). Rendered as DrawingImage so they stay crisp at any size.  -->

    <!-- RTD: a resistance temperature detector drawn as a thermometer probe. -->
    <DrawingImage x:Key="RtdImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Stem -->
                <GeometryDrawing Brush="#E9EEF2">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="20,4,8,28" RadiusX="4" RadiusY="4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Bulb -->
                <GeometryDrawing Brush="#E5463C">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="24,38" RadiusX="9" RadiusY="9" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Mercury column -->
                <GeometryDrawing Brush="#E5463C">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="22,16,4,22" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Scale ticks -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#9AA6B0" Thickness="1.5" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="30,12" EndPoint="35,12" />
                            <LineGeometry StartPoint="30,20" EndPoint="35,20" />
                            <LineGeometry StartPoint="30,28" EndPoint="35,28" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- TermoSprega (thermocouple): two dissimilar wires joined at a hot bead. -->
    <DrawingImage x:Key="TermoSpregaImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Two wires -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF7A37" Thickness="3" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="8,8" EndPoint="24,30" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#9AA6B0" Thickness="3" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="40,8" EndPoint="24,30" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Junction bead (hot point) -->
                <GeometryDrawing Brush="#E5463C">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="24,32" RadiusX="6" RadiusY="6" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Reactor flame icon used on the Home screen. -->
    <DrawingImage x:Key="ReactorImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FF7A37"
                                 Geometry="M24,4 C24,4 13,15 13,27 a11,11 0 1,0 22,0 C35,15 24,4 24,4 Z" />
                <GeometryDrawing Brush="#E5463C"
                                 Geometry="M24,18 C24,18 19,24 19,30 a5,5 0 1,0 10,0 C29,24 24,18 24,18 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
