<UserControl x:Class="NetworkService.Views.NetworkDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">

    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== TreeView of available (not placed) entities, grouped by type ===== -->
        <TextBlock Grid.Row="0" Text="Entiteti (TreeView)" Style="{StaticResource SectionTitle}" FontSize="16" />
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8"
                Padding="4" MaxHeight="150" Margin="0,0,0,10">
            <TreeView x:Name="EntityTree" ItemsSource="{Binding TreeGroups}"
                      AllowDrop="True" Drop="Tree_Drop"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{StaticResource TextBrush}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ToolTip="Prevucite entitet na mrežu. Vratite ga prevlačenjem nazad u listu.">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Items}">
                        <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" FontSize="14" />
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelAltBrush}" CornerRadius="6"
                                        Padding="8,4" Margin="0,2" Cursor="Hand"
                                        PreviewMouseLeftButtonDown="TreeItem_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="TreeItem_PreviewMouseMove">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Type.ImageKey, Converter={StaticResource ImageKey}}"
                                               Width="18" Height="18" />
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Id, StringFormat=' (ID:{0})'}"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- ===== Drag&Drop grid ===== -->
        <TextBlock Grid.Row="2" Text="Drag&amp;Drop mreža" Style="{StaticResource SectionTitle}" FontSize="16" />
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" HorizontalAlignment="Center">

                <!-- Connection lines (behind the cells, do not capture the mouse) -->
                <ItemsControl ItemsSource="{Binding Connections}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Grid cells (canvases) -->
                <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding Width}" Height="{Binding Height}"
                                    CornerRadius="8" BorderThickness="2" AllowDrop="True"
                                    Drop="Slot_Drop"
                                    PreviewMouseLeftButtonDown="Slot_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Slot_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="Slot_PreviewMouseLeftButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Entity.IsValid}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                                <Setter Property="BorderBrush" Value="#FF8A82" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <!-- Empty cell -->
                                    <TextBlock Text="Prazno" Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                                    <!-- Occupied cell -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{Binding Entity.Name}">
                                        <Image Source="{Binding Entity.Type.ImageKey, Converter={StaticResource ImageKey}}"
                                               Width="26" Height="26" />
                                        <TextBlock Text="{Binding Entity.Id, StringFormat='ID:{0}'}"
                                                   Foreground="White" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Entity.LastValueDisplay}"
                                                   Foreground="White" FontSize="11"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
