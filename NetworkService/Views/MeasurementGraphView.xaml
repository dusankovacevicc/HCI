<UserControl x:Class="NetworkService.Views.MeasurementGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Istorija merenja" Style="{StaticResource SectionTitle}" />

        <!-- Entity selector -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <ComboBox ItemsSource="{Binding Entities}" SelectedItem="{Binding SelectedEntity}"
                      DisplayMemberPath="Name" Height="36" FontSize="14"
                      ToolTip="Izaberite entitet za koji se prikazuje istorija merenja" />
            <TextBlock Text="Izaberi entitet" IsHitTestVisible="False"
                       Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding SelectedEntity, Converter={StaticResource NullToVis}}" />
        </Grid>

        <!-- Programmatically drawn graph (G3) -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="6">
            <Grid>
                <Canvas x:Name="GraphCanvas" ClipToBounds="True" />
                <TextBlock x:Name="EmptyHint" Text="Nema podataka za prikaz"
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Legend -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Border Background="{StaticResource ValidBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                <TextBlock Text="validno (250–350)" Foreground="White" FontSize="13" />
            </Border>
            <Border Background="{StaticResource DangerBrush}" CornerRadius="6" Padding="12,6">
                <TextBlock Text="nevalidno" Foreground="White" FontSize="13" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="Grafikon se osvežava automatski (real time)."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" />
            <TextBlock Text="Prikazuje poslednjih 5 vrednosti iz log.txt."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
