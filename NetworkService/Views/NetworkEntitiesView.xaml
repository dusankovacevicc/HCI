<UserControl x:Class="NetworkService.Views.NetworkEntitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Search (P1) ===== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Pretraga" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <RadioButton Style="{StaticResource AppRadio}" GroupName="SearchBy"
                             Content="Naziv" IsChecked="{Binding SearchByName}"
                             ToolTip="Pretraga po nazivu entiteta" />
                <RadioButton Style="{StaticResource AppRadio}" GroupName="SearchBy"
                             Content="Tip" IsChecked="{Binding SearchByType}"
                             ToolTip="Pretraga po nazivu tipa" />
            </StackPanel>
            <TextBox Style="{StaticResource AppTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Unesite deo naziva ili tipa za pretragu" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource AccentButton}"
                        Command="{Binding ApplyFilterCommand}" Content="Pretraži" />
                <Button Grid.Column="2" Style="{StaticResource BaseButton}"
                        Command="{Binding ResetFilterCommand}"
                        ToolTip="Vraća prikaz svih entiteta" Content="Poništi" />
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Entiteti" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />

        <!-- ===== Table ===== -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Entities}"
                  SelectedItem="{Binding SelectedEntity}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
                  RowBackground="{StaticResource PanelBrush}"
                  AlternatingRowBackground="{StaticResource PanelAltBrush}"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                  RowHeight="34" FontSize="13" SelectionMode="Single">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource HeaderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="0.6*" />
                <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="1.4*" />
                <DataGridTextColumn Header="Tip" Binding="{Binding Type.Name}" Width="1.2*" />
                <DataGridTemplateColumn Header="Vrednost" Width="1.2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                <Ellipse Width="9" Height="9" Margin="0,0,6,0"
                                         Fill="{Binding IsValid, Converter={StaticResource ValidToBrush}}" />
                                <TextBlock Text="{Binding LastValueDisplay}"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== Add / Delete ===== -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource AccentButton}"
                    Command="{Binding AddCommand}"
                    ToolTip="Otvara formu za dodavanje novog entiteta" Content="+ Dodaj" />
            <Button Grid.Column="2" Style="{StaticResource DangerButton}"
                    Command="{Binding DeleteCommand}"
                    ToolTip="Briše izabrani entitet (uz potvrdu)" Content="Obriši" />
        </Grid>
    </Grid>
</UserControl>
