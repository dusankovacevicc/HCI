<UserControl x:Class="NetworkService.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">

    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Theme icon -->
        <Border Grid.Row="0" Width="120" Height="120" CornerRadius="60"
                Background="{StaticResource PanelBrush}" HorizontalAlignment="Center"
                Margin="0,6,0,8">
            <Image Source="{StaticResource ReactorImage}" Width="62" Height="62" />
        </Border>

        <TextBlock Grid.Row="1" Text="Temperatura reaktora" HorizontalAlignment="Center"
                   Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,0,0,4" />

        <TextBlock Grid.Row="2" Text="Simulator infrastrukturnog sistema"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="SemiBold"
                   Margin="0,0,0,18" />

        <!-- Navigation -->
        <StackPanel Grid.Row="3">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource NavButton}"
                        Command="{Binding OpenEntitiesCommand}"
                        ToolTip="Tabelarni prikaz, dodavanje i brisanje entiteta (Ctrl+1)"
                        Content="Entiteti" />
                <Button Grid.Column="2" Style="{StaticResource NavButton}"
                        Command="{Binding OpenDisplayCommand}"
                        ToolTip="Drag&amp;Drop mreža entiteta (Ctrl+2)"
                        Content="Mreža" />
            </Grid>
            <Button Style="{StaticResource NavButton}"
                    Command="{Binding OpenGraphCommand}"
                    ToolTip="Istorija merenja u realnom vremenu (Ctrl+3)"
                    Content="Grafikon" />
        </StackPanel>

        <!-- Out-of-range warning banner -->
        <Border Grid.Row="4" Background="{StaticResource HeaderBrush}" CornerRadius="10"
                Padding="14,10" Margin="0,18,0,0"
                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x26A0;" Foreground="{StaticResource DangerBrush}"
                           FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding WarningText}" Foreground="{StaticResource TextBrush}"
                           FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
