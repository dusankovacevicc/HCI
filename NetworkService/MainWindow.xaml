<Window x:Class="NetworkService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NetworkService.ViewModels"
        xmlns:v="clr-namespace:NetworkService.Views"
        Title="Simulator infrastrukturnog sistema"
        Height="820" Width="412"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#0E1216"
        FontFamily="{StaticResource AppFont}">

    <!-- Keyboard shortcuts for navigation and undo (specification requirement). -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Control" Key="H" Command="{Binding HomeCommand}" />
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding EntitiesCommand}" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding DisplayCommand}" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding GraphCommand}" />
    </Window.InputBindings>

    <!-- DataTemplates connect each page ViewModel with its View. -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <v:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkEntitiesViewModel}">
            <v:NetworkEntitiesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkDisplayViewModel}">
            <v:NetworkDisplayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MeasurementGraphViewModel}">
            <v:MeasurementGraphView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddEntityViewModel}">
            <v:AddEntityView />
        </DataTemplate>
    </Window.Resources>

    <!-- Phone bezel -->
    <Border Background="#0E1216" CornerRadius="30" Padding="10">
        <Border Background="{StaticResource ScreenBrush}" CornerRadius="22" ClipToBounds="True">
            <Grid>
                <!-- Screen content -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="56" />
                    </Grid.RowDefinitions>

                    <!-- Header bar -->
                    <Border Grid.Row="0" Background="{StaticResource HeaderBrush}">
                        <Grid Margin="16,0">
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"
                                       FontSize="18" FontWeight="SemiBold">
                                <Run Text="&#x2630;" FontSize="18" />
                                <Run Text="  " />
                                <Run Text="{Binding CurrentViewModel.Title, Mode=OneWay}" />
                            </TextBlock>

                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource BaseButton}"
                                    Padding="12,6" FontSize="13"
                                    Command="{Binding UndoCommand}"
                                    ToolTip="{Binding UndoManager.NextUndoDescription}"
                                    Visibility="{Binding UndoManager.CanUndo, Converter={StaticResource BoolToVis}}"
                                    Content="&#x21A9; Undo" />
                        </Grid>
                    </Border>

                    <!-- Active view -->
                    <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />

                    <!-- Persistent bottom bar with Home button (CG3) -->
                    <Border Grid.Row="2" Background="{StaticResource HeaderBrush}">
                        <Button Style="{StaticResource HomeButton}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Command="{Binding HomeCommand}"
                                ToolTip="Povratak na početni ekran (Ctrl+H)"
                                Content="Home" />
                    </Border>
                </Grid>

                <!-- Toast notification overlay -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                        Margin="14,0,14,68"
                        CornerRadius="10" Padding="14,10"
                        Background="{Binding Toast.Type, Converter={StaticResource ToastTypeToBrush}}"
                        Visibility="{Binding Toast.IsVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Toast.Title}" Foreground="White"
                                   FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="{Binding Toast.Message}" Foreground="White"
                                   FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Confirmation dialog overlay -->
                <Grid Background="#AA000000"
                      Visibility="{Binding Confirmation.IsVisible, Converter={StaticResource BoolToVis}}">
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14"
                            Padding="20" Margin="28" VerticalAlignment="Center"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding Confirmation.Title}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Confirmation.Message}" Foreground="{StaticResource TextBrush}"
                                       FontSize="14" TextWrapping="Wrap" Margin="0,0,0,18" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource BaseButton}"
                                        Command="{Binding Confirmation.CancelCommand}" Content="Otkaži" />
                                <Button Grid.Column="2" Style="{StaticResource DangerButton}"
                                        Command="{Binding Confirmation.ConfirmCommand}" Content="Obriši" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
